  "bin": { "mic-lab": "cli/mic-lab.js" },
  "scripts": {
    "start": "node cli/mic-lab.js serve",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": { "node": ">=22" },
  "optionalDependencies": { "node-hid": "^3.1.0" },
  "files": ["index.html", "app", "core", "adapters", "cli", "vendor", "AGENTS.md", "README.md", "LICENSE"],
  "keywords": ["microphone", "shure", "mv7", "mv7+", "audio", "loudness", "webhid", "obs"]
}
